# Copy to .env.pilot on the VPS, replace every replace-with value, and chmod 600.
IRIS_PUBLIC_HOSTNAME=iris.example.com
CADDY_EMAIL=ops@example.com
IRIS_CORE_LOOPBACK_PORT=3000
IRIS_IMAGE_TAG=replace-with-approved-commit-sha

POSTGRES_USER=iris_admin
POSTGRES_PASSWORD=replace-with-url-safe-admin-password
POSTGRES_DB=iris
IRIS_MIGRATOR_USER=iris_migrator
IRIS_MIGRATOR_PASSWORD=replace-with-url-safe-migrator-password
IRIS_APP_USER=iris_app
IRIS_APP_PASSWORD=replace-with-url-safe-app-password
DATABASE_MIGRATION_URL=postgres://iris_migrator:replace-with-url-safe-migrator-password@postgres:5432/iris
DATABASE_URL=postgres://iris_app:replace-with-url-safe-app-password@postgres:5432/iris
REDIS_URL=redis://redis:6379

IRIS_INTERNAL_API_TOKEN=replace-with-single-visible-ascii-token
IRIS_INGRESS_HEALTH_TOKEN=replace-with-separate-health-only-token
IRIS_AI_WORKER_TOKEN=replace-with-separate-ai-worker-token
IRIS_RUNTIME_GLOBAL_ENABLED=false
IRIS_AGENT_EXECUTION_LEDGER_ENABLED=false

FEISHU_VERIFICATION_TOKEN=replace-with-feishu-verification-token
FEISHU_ENCRYPT_KEY=
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_OPEN_BASE_URL=https://open.feishu.cn
IRIS_FEISHU_BOT_OPEN_ID=replace-with-iris-bot-open-id
IRIS_FEISHU_DOCUMENT_FETCH_TIMEOUT_MS=10000
IRIS_FEISHU_DOCUMENT_MAX_CONTENT_CHARS=2000000

IRIS_EVENT_WORKER_ENABLED=true
IRIS_EVENT_WORKER_INTERVAL_MS=1000
IRIS_EVENT_WORKER_BATCH_LIMIT=50
IRIS_DOCUMENT_SYNC_WORKER_ENABLED=true
IRIS_DOCUMENT_SYNC_WORKER_INTERVAL_MS=1000
IRIS_DOCUMENT_SYNC_WORKER_BATCH_LIMIT=10
IRIS_REINDEX_WORKER_ENABLED=true
IRIS_REINDEX_WORKER_INTERVAL_MS=1000
IRIS_REINDEX_WORKER_BATCH_LIMIT=25

IRIS_MODEL_PROVIDER=openai-compatible
IRIS_MODEL_BASE_URL=https://api.example.com/v1
IRIS_MODEL_API_KEY=replace-with-model-api-key
IRIS_MODEL_NAME=replace-with-model-name
IRIS_MODEL_TIMEOUT_MS=30000

IRIS_MEMORY_EXTRACTION_ENABLED=false
IRIS_MEMORY_EXTRACTION_INTERVAL_MS=1000
IRIS_MEMORY_EXTRACTION_BATCH_LIMIT=20
IRIS_MEMORY_EXTRACTION_MIN_CONFIDENCE=0.85
IRIS_THREAD_EXTRACTION_GROUP_IDS=
IRIS_ACTION_EXTRACTION_GROUP_IDS=
IRIS_THREAD_CANDIDATE_CONFIDENCE_FLOOR=0.65
IRIS_MEMORY_EXTRACTION_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IRIS_MEMORY_EXTRACTION_MODEL_API_KEY=replace-with-memory-extraction-model-api-key
IRIS_MEMORY_EXTRACTION_MODEL_NAME=replace-with-memory-extraction-model-name
IRIS_MEMORY_EXTRACTION_MODEL_TIMEOUT_MS=30000
IRIS_MEMORY_EXTRACTION_MODEL_MAX_RESPONSE_BYTES=65536

IRIS_EMBEDDING_PROVIDER=openai-compatible
IRIS_EMBEDDING_BASE_URL=https://api.example.com/v1
IRIS_EMBEDDING_API_KEY=replace-with-embedding-api-key
IRIS_EMBEDDING_MODEL=replace-with-embedding-model
IRIS_EMBEDDING_DIMENSIONS=1536
IRIS_EMBEDDING_TIMEOUT_MS=30000

IRIS_ENABLE_INTERNAL_ANSWER_DRAFTS=true
IRIS_INTERNAL_DRAFT_PERMISSION_MODE=source-policy

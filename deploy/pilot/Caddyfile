{
  email {$CADDY_EMAIL}
}

{$IRIS_PUBLIC_HOSTNAME} {
  encode zstd gzip

  @feishu path /feishu/events /feishu/card-actions
  handle @feishu {
    reverse_proxy core:3000 {
      health_uri /internal/ingress-readiness
      health_headers {
        Authorization "Bearer {$IRIS_INGRESS_HEALTH_TOKEN}"
      }
      health_interval 2s
      health_timeout 2s
      health_status 2xx
    }
  }

  @health path /health
  handle @health {
    reverse_proxy core:3000
  }

  @reviewProposal {
    method GET
    path_regexp review_proposal ^/review/action-proposals/[^/]+$
  }
  handle @reviewProposal {
    reverse_proxy core:3000
  }

  @reviewOAuthCallback {
    method GET
    path /review/oauth/callback
  }
  handle @reviewOAuthCallback {
    reverse_proxy core:3000
  }

  @reviewAttestation {
    method POST
    path_regexp review_attestation ^/review/action-proposals/[^/]+/attest$
  }
  handle @reviewAttestation {
    reverse_proxy core:3000
  }

  handle {
    respond 404
  }
}

{
  email {$CADDY_EMAIL}
}

{$IRIS_PUBLIC_HOSTNAME} {
  encode zstd gzip

  @feishu path /feishu/events
  handle @feishu {
    reverse_proxy core:3000 {
      health_uri /internal/ingress-readiness
      health_headers {
        Authorization "Bearer {$IRIS_INGRESS_HEALTH_TOKEN}"
      }
      health_interval 2s
      health_timeout 2s
      health_status 2xx
    }
  }

  @health path /health
  handle @health {
    reverse_proxy core:3000
  }

  handle {
    respond 404
  }
}

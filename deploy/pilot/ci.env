IRIS_PUBLIC_HOSTNAME=http://
CADDY_EMAIL=ci@example.com
IRIS_CORE_LOOPBACK_PORT=3000
IRIS_IMAGE_TAG=ci

POSTGRES_USER=iris
POSTGRES_PASSWORD=iris_ci_password
POSTGRES_DB=iris
DATABASE_URL=postgres://iris:iris_ci_password@postgres:5432/iris
REDIS_URL=redis://redis:6379

IRIS_INTERNAL_API_TOKEN=ci-internal-token

FEISHU_VERIFICATION_TOKEN=ci-verification-token
FEISHU_ENCRYPT_KEY=
FEISHU_APP_ID=cli_ci_app_id
FEISHU_APP_SECRET=ci-app-secret
FEISHU_OPEN_BASE_URL=https://open.feishu.cn
IRIS_FEISHU_BOT_OPEN_ID=ou_ci_iris_bot
IRIS_FEISHU_DOCUMENT_FETCH_TIMEOUT_MS=10000
IRIS_FEISHU_DOCUMENT_MAX_CONTENT_CHARS=2000000

IRIS_EVENT_WORKER_ENABLED=true
IRIS_EVENT_WORKER_INTERVAL_MS=60000
IRIS_EVENT_WORKER_BATCH_LIMIT=50
IRIS_DOCUMENT_SYNC_WORKER_ENABLED=true
IRIS_DOCUMENT_SYNC_WORKER_INTERVAL_MS=1000
IRIS_DOCUMENT_SYNC_WORKER_BATCH_LIMIT=10
IRIS_REINDEX_WORKER_ENABLED=true
IRIS_REINDEX_WORKER_INTERVAL_MS=1000
IRIS_REINDEX_WORKER_BATCH_LIMIT=25

IRIS_MODEL_PROVIDER=openai-compatible
IRIS_MODEL_BASE_URL=https://model.invalid/v1
IRIS_MODEL_API_KEY=ci-model-key
IRIS_MODEL_NAME=ci-model
IRIS_MODEL_TIMEOUT_MS=30000

IRIS_EMBEDDING_PROVIDER=openai-compatible
IRIS_EMBEDDING_BASE_URL=https://embedding.invalid/v1
IRIS_EMBEDDING_API_KEY=ci-embedding-key
IRIS_EMBEDDING_MODEL=ci-embedding-model
IRIS_EMBEDDING_DIMENSIONS=1536
IRIS_EMBEDDING_TIMEOUT_MS=30000

IRIS_ENABLE_INTERNAL_ANSWER_DRAFTS=true
IRIS_INTERNAL_DRAFT_PERMISSION_MODE=source-policy

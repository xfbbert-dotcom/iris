IRIS_PUBLIC_HOSTNAME=http://
CADDY_EMAIL=ci@example.com
IRIS_CORE_LOOPBACK_PORT=3000
IRIS_IMAGE_TAG=ci

POSTGRES_USER=iris_admin
POSTGRES_PASSWORD=iris_ci_admin_password
POSTGRES_DB=iris
IRIS_MIGRATOR_USER=iris_migrator
IRIS_MIGRATOR_PASSWORD=iris_ci_migrator_password
IRIS_APP_USER=iris_app
IRIS_APP_PASSWORD=iris_ci_app_password
DATABASE_MIGRATION_URL=postgres://iris_migrator:iris_ci_migrator_password@postgres:5432/iris
DATABASE_URL=postgres://iris_app:iris_ci_app_password@postgres:5432/iris
REDIS_URL=redis://redis:6379

IRIS_INTERNAL_API_TOKEN=ci-internal-token
IRIS_INGRESS_HEALTH_TOKEN=ci-ingress-health-token
IRIS_AI_WORKER_TOKEN=ci-ai-worker-token

FEISHU_VERIFICATION_TOKEN=ci-verification-token
FEISHU_ENCRYPT_KEY=
FEISHU_APP_ID=cli_ci_app_id
FEISHU_APP_SECRET=ci-app-secret
FEISHU_OPEN_BASE_URL=https://open.feishu.cn
IRIS_FEISHU_BOT_OPEN_ID=ou_ciirisbot
IRIS_FEISHU_DOCUMENT_FETCH_TIMEOUT_MS=10000
IRIS_FEISHU_DOCUMENT_MAX_CONTENT_CHARS=2000000

IRIS_EVENT_WORKER_ENABLED=true
IRIS_EVENT_WORKER_INTERVAL_MS=60000
IRIS_EVENT_WORKER_BATCH_LIMIT=50
IRIS_DOCUMENT_SYNC_WORKER_ENABLED=true
IRIS_DOCUMENT_SYNC_WORKER_INTERVAL_MS=1000
IRIS_DOCUMENT_SYNC_WORKER_BATCH_LIMIT=10
IRIS_REINDEX_WORKER_ENABLED=true
IRIS_REINDEX_WORKER_INTERVAL_MS=1000
IRIS_REINDEX_WORKER_BATCH_LIMIT=25

IRIS_MODEL_PROVIDER=openai-compatible
IRIS_MODEL_BASE_URL=https://model.invalid/v1
IRIS_MODEL_API_KEY=ci-model-key
IRIS_MODEL_NAME=ci-model
IRIS_MODEL_TIMEOUT_MS=30000

IRIS_MEMORY_EXTRACTION_ENABLED=false
IRIS_MEMORY_EXTRACTION_INTERVAL_MS=1000
IRIS_MEMORY_EXTRACTION_BATCH_LIMIT=20
IRIS_MEMORY_EXTRACTION_MIN_CONFIDENCE=0.85
IRIS_THREAD_EXTRACTION_GROUP_IDS=
IRIS_ACTION_EXTRACTION_GROUP_IDS=
IRIS_THREAD_CANDIDATE_CONFIDENCE_FLOOR=0.65
IRIS_PROACTIVE_CANDIDATE_SCANNING_ENABLED=false
IRIS_PROACTIVE_CANDIDATE_GROUP_IDS=
IRIS_PROACTIVE_CANDIDATE_INTERVAL_MS=300000
IRIS_PROACTIVE_CANDIDATE_BATCH_LIMIT=50
IRIS_PROACTIVE_CANDIDATE_MIN_CONFIDENCE=0.7
IRIS_PROACTIVE_CANDIDATE_QUIET_THREAD_MS=86400000
IRIS_PROACTIVE_CANDIDATE_QUIET_ACTION_MS=86400000
IRIS_PROACTIVE_CANDIDATE_OVERDUE_GRACE_MS=1800000
IRIS_MEMORY_EXTRACTION_MODEL_BASE_URL=https://memory-model.invalid/v1
IRIS_MEMORY_EXTRACTION_MODEL_API_KEY=ci-memory-model-key
IRIS_MEMORY_EXTRACTION_MODEL_NAME=ci-memory-model
IRIS_MEMORY_EXTRACTION_MODEL_TIMEOUT_MS=30000
IRIS_MEMORY_EXTRACTION_MODEL_MAX_RESPONSE_BYTES=65536

IRIS_EMBEDDING_PROVIDER=openai-compatible
IRIS_EMBEDDING_BASE_URL=https://embedding.invalid/v1
IRIS_EMBEDDING_API_KEY=ci-embedding-key
IRIS_EMBEDDING_MODEL=ci-embedding-model
IRIS_EMBEDDING_DIMENSIONS=1536
IRIS_EMBEDDING_TIMEOUT_MS=30000

IRIS_ENABLE_INTERNAL_ANSWER_DRAFTS=true
IRIS_INTERNAL_DRAFT_PERMISSION_MODE=source-policy
